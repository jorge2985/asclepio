PORT=8080
APP_ENV=development

# Usa credenciales locales propias. No subas archivos .env reales al repositorio.
DATABASE_URL=postgres://usuario:password@localhost:5432/asclepio?sslmode=disable

# Genera un valor largo y aleatorio para cada entorno.
JWT_SECRET=change-me-use-a-long-random-secret

JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
